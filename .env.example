# Copy this file to .env and fill in your own values.
# Never commit .env or paste AWS access keys into source code.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_USERNAME=your-admin-username
APP_PASSWORD_HASH=paste-a-Werkzeug-password-hash-here
AWS_REGION=ap-south-1
S3_BUCKET=your-private-s3-bucket-name
APP_TIMEZONE=Asia/Kolkata
MAX_UPLOAD_MB=16
# Set to true when the app is served over HTTPS in production.
SESSION_COOKIE_SECURE=false
